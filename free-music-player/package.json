{
  "name": "free-music-player",
  "version": "1.0.1",
  "description": "Free music player with YouTube streaming",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p electron/tsconfig.json && vite build && electron-builder",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "electron:build": "tsc -p electron/tsconfig.json && vite build && electron-builder",
    "publish": "tsc -p electron/tsconfig.json && vite build && electron-builder --publish always",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "rebuild:electron": "electron-rebuild"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "better-sqlite3": "^11.7.0",
    "electron-updater": "^6.5.0",
    "framer-motion": "^12.0.0",
    "isomorphic-unfetch": "^4.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "youtube-dl-exec": "^3.1.0",
    "youtubei.js": "^17.0.1",
    "ytmusic-api": "^5.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
