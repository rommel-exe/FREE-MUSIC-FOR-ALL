{
  "name": "free-music-player",
  "version": "1.0.0",
  "description": "Free music player with YouTube streaming, downloads, and playlist import",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p electron/tsconfig.json && vite build && electron-builder",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "electron:build": "tsc -p electron/tsconfig.json && vite build && electron-builder",
    "rebuild:electron": "electron-rebuild"
  },
  "dependencies": {
    "@stef-0012/synclyrics": "^2.5.0",
    "better-sqlite3": "^11.7.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.0.0",
    "isomorphic-unfetch": "^4.0.2",
    "lucide-react": "^0.468.0",
    "music-metadata": "^10.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spotify-url-info": "^3.0.0",
    "youtube-dl-exec": "^3.1.0",
    "ytmusic-api": "^5.3.1",
    "ytpl": "^1.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
